---
import Check from '../components/Check.tsx';
import Base from '../layouts/Base.astro';
import { snapshot } from '../lib/data.ts';
---
<Base title="Check wallets · hidden funds" description="Paste Aptos or Movement addresses to find funds you can still withdraw or claim.">
  <h1>Check wallets</h1>
  <p class="muted">
    Paste Aptos or Movement addresses. Your browser reads both mainnets directly; addresses are not sent to this site.
    The public Aptos Labs and Movement APIs see the requests. Bridge lookups through third parties are off unless you
    switch them on below.
  </p>
  <Check client:load prices={snapshot?.prices ?? {}} markets={snapshot?.markets} />
</Base>
