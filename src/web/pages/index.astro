---
import Base from '../layouts/Base.astro';
import { snapshot } from '../lib/data.ts';
import { count, date, usd } from '../lib/format.ts';

const statuses = [
  ['recoverable', 'You can claim'],
  ['team_gated', 'Needs the team'],
  ['blocked', 'May not work'],
] as const;
---
<Base title="hidden funds · Aptos">
  {snapshot ? (
    <>
      <h1>{usd(snapshot.global.headlineUsd)} left behind on Aptos</h1>
      <p class="muted">
        Withdrawable for 90 days or more and never withdrawn, across {count(snapshot.global.headlineOwners)} wallets
        ({count(snapshot.global.headlineOwnersMin10)} with $10 or more). Updated weekly; as of {date(snapshot.generatedAt)}.
      </p>
      <p><a class="button" href="/check">Check my wallets</a></p>

      <h2>Who can get it back</h2>
      <div class="cards">
        {statuses.map(([key, label]) => (
          <div class="card">
            <span class="muted">{label}</span>
            <b>{usd(snapshot.sources.reduce((s, x) => s + x.totals.byStatus[key].usd, 0))}</b>
            <span class="muted">{count(snapshot.sources.reduce((s, x) => s + x.totals.byStatus[key].positions, 0))} positions</span>
          </div>
        ))}
      </div>
      <p class="muted">"You can claim" counts every withdrawable position, any age. The headline above counts only those aged 90+ days.</p>

      <h2>Sources</h2>
      <div class="table">
        <table>
          <thead><tr><th>Source</th><th class="num">Left behind 90+ days</th><th class="num">Wallets</th><th class="num">Claimable now</th><th>Data</th></tr></thead>
          <tbody>
            {snapshot.sources.map(s => (
              <tr>
                <td><a href={`/source/${s.id}`}>{s.title}</a></td>
                <td class="num">{usd(s.totals.headline.usd)}</td>
                <td class="num">{count(s.totals.headline.owners)}</td>
                <td class="num">{usd(s.totals.byStatus.recoverable.usd)}</td>
                <td>
                  <span class={`badge ${s.run.completeness}`}>{s.run.completeness}</span>
                  <div class="muted">as of {date(s.run.verification.end ?? s.lastSuccessAt)}</div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ) : (
    <>
      <h1>hidden funds · Aptos</h1>
      <p class="muted">The first weekly snapshot has not run yet. You can still check wallets live.</p>
      <p><a class="button" href="/check">Check my wallets</a></p>
    </>
  )}
</Base>
