---
import Donut from '../components/Donut.astro';
import Base from '../layouts/Base.astro';
import { byProtocol, snapshot } from '../lib/data.ts';
import { count, date, usd } from '../lib/format.ts';
import { NETWORKS, type Network } from '../../shared/chain.ts';

const statuses = [
  ['recoverable', 'You can claim'],
  ['team_gated', 'Needs the team'],
  ['blocked', 'May not work'],
  ['contract_held', 'Held by a contract'],
] as const;
// Snapshots from before a status existed have no bucket for it.
const EMPTY = { usd: 0, positions: 0, unpriced: 0 };
/** What can be claimed is its payout; the rest is what it is owed (often no payout yet), where the snapshot has it. */
const bucketOf = (s: NonNullable<typeof snapshot>['sources'][number], key: (typeof statuses)[number][0]) =>
  key === 'recoverable' ? s.totals.byStatus[key] : (s.totals.faceByStatus?.[key] ?? s.totals.byStatus[key]);
const views = [
  { key: 'both', label: 'Both', sources: snapshot?.sources ?? [] },
  { key: 'aptos', label: 'Aptos', sources: (snapshot?.sources ?? []).filter(s => s.chain === 'aptos') },
  { key: 'movement', label: 'Movement', sources: (snapshot?.sources ?? []).filter(s => s.chain === 'movement') },
];
---
<Base title="Dashboard · hidden funds" description="What is left behind on Aptos and Movement, per source and protocol, updated weekly.">
  {snapshot ? (
    <>
      <h1>{usd(snapshot.global.headlineUsd)} left behind on Aptos and Movement</h1>
      <p class="muted">
        Withdrawable for 90 days or more and never withdrawn, across {count(snapshot.global.headlineOwners)} wallets
        ({count(snapshot.global.headlineOwnersMin10)} with $10 or more). Updated weekly; as of {date(snapshot.generatedAt)}.
      </p>

      <h2>By protocol</h2>
      <div class="toggle" role="group" aria-label="Chain">
        {views.map((v, i) => <button type="button" data-view={v.key} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>)}
      </div>
      {views.map((v, i) => (
        <div class="view" data-view={v.key} hidden={i !== 0}>
          <Donut slices={byProtocol(v.sources)} label={`Left behind 90+ days by protocol, ${v.label}`} />
        </div>
      ))}

      <h2>Who can get it back</h2>
      <div class="cards">
        {statuses.map(([key, label]) => (
          <div class="card">
            <span class="muted">{label}</span>
            <b>{usd(snapshot.sources.reduce((s, x) => s + (bucketOf(x, key) ?? EMPTY).usd, 0))}</b>
            <span class="muted">{count(snapshot.sources.reduce((s, x) => s + (x.totals.byStatus[key] ?? EMPTY).positions, 0))} positions{(() => {
              const unpriced = snapshot.sources.reduce((s, x) => s + (bucketOf(x, key) ?? EMPTY).unpriced, 0);
              return unpriced ? `, ${count(unpriced)} without a price (not in this value)` : '';
            })()}</span>
          </div>
        ))}
      </div>
      <p class="muted">"You can claim" counts every withdrawable position, any age. The headline above counts only those aged 90+ days.</p>

      <h2>Sources</h2>
      <div class="table">
        <table>
          <thead><tr><th>Source</th><th class="num">Left behind 90+ days</th><th class="num">Wallets</th><th class="num">Claimable now</th><th>Data</th></tr></thead>
          <tbody>
            {[...snapshot.sources].sort((a, b) => b.totals.headline.usd - a.totals.headline.usd).map(s => (
              <tr>
                <td><a href={`/source/${s.id}`}>{s.title}</a><div class="muted">{NETWORKS[s.chain as Network]?.name ?? s.chain}</div></td>
                <td class="num">{usd(s.totals.headline.usd)}</td>
                <td class="num">{count(s.totals.headline.owners)}</td>
                <td class="num">{usd(s.totals.byStatus.recoverable.usd)}</td>
                <td>
                  <span class={`badge ${s.run.completeness}`}>{s.run.completeness}</span>
                  <div class="muted">as of {date(s.run.verification.end ?? s.lastSuccessAt)}</div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ) : (
    <>
      <h1>Dashboard</h1>
      <p class="muted">The first weekly snapshot has not run yet. You can still check wallets live.</p>
      <p><a class="button" href="/check">Check my wallets</a></p>
    </>
  )}
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.toggle button');
  const panels = document.querySelectorAll<HTMLElement>('.view');
  for (const b of buttons) b.addEventListener('click', () => {
    for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
    for (const p of panels) p.hidden = p.dataset.view !== b.dataset.view;
  });
</script>

<style>
  .toggle { display: inline-flex; background: var(--soft); border: 1px solid var(--line); border-radius: 10px; padding: 3px; margin-bottom: 20px; }
  .toggle button { font: inherit; font-size: 14px; border: 0; background: transparent; color: var(--muted); padding: 6px 14px; border-radius: 8px; cursor: pointer; }
  .toggle button[aria-pressed="true"] { background: var(--card); color: var(--fg); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
</style>
